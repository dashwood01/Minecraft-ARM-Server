# Runtime settings for running the x86_64 Bedrock Dedicated Server on ARM64
# through Box64. Sourced by scripts/start.sh (and therefore by the systemd unit)
# and by scripts/check-compat.sh.

# --- Official Bedrock Dedicated Server location --------------------------------
# Directory holding the official Linux BDS files that YOU downloaded from
# minecraft.net (bedrock_server, server.properties, worlds/, ...). It is NOT
# part of this repository and must be outside it.
# An existing BDS_DIR environment variable takes precedence over this default.
# The systemd unit sets BDS_DIR explicitly (see scripts/install-service.sh).
BDS_DIR="${BDS_DIR:-$HOME/minecraft-bedrock-server}"
case "$BDS_DIR" in /*) ;; *) BDS_DIR="$PWD/$BDS_DIR" ;; esac
export BDS_DIR

# --- Box64 ---------------------------------------------------------------------
# Box64 binary (installed by scripts/install-deps.sh)
BOX64_BIN="${BOX64_BIN:-/usr/local/bin/box64}"

# Quiet Box64 startup output so the server console stays readable.
export BOX64_NOBANNER=1
export BOX64_LOG=0

# DynaCache: keeps translated ARM64 code on disk so later starts use far less
# CPU. The first start is slow; subsequent starts reuse the cache. It is runtime
# data, so it lives next to the server files, not in this repository.
export BOX64_DYNACACHE=1
export BOX64_DYNACACHE_FOLDER="$BDS_DIR/.box64-cache"
export BOX64_DYNACACHE_LIMIT=1024

# x86 has a stronger memory model than ARM. Box64's default (0) is fastest.
# If you see random crashes/hangs under load, try 1 (small CPU cost), then 2.
export BOX64_DYNAREC_STRONGMEM=0

# BDS ships no shared libraries of its own, but Mojang's docs launch it with
# LD_LIBRARY_PATH=. from the server directory — keep that behaviour for the
# emulated process.
export BOX64_LD_LIBRARY_PATH="$BDS_DIR${BOX64_LD_LIBRARY_PATH:+:$BOX64_LD_LIBRARY_PATH}"
